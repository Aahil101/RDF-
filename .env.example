# ===========================================================================
# VeriRAG configuration.  Copy to `.env` and edit.  Every option below has a
# working default, and the whole system runs with NO keys at all.
# ===========================================================================

# --- LLM provider ----------------------------------------------------------
# auto        : try groq -> gemini -> ollama -> extractive (recommended)
# groq        : FREE tier, very fast. Key: https://console.groq.com/keys
# gemini      : FREE tier. Key: https://aistudio.google.com/apikey
# ollama      : fully local, no key. https://ollama.com  (ollama pull llama3.2)
# extractive  : no LLM at all. Answers are stitched from retrieved lines.
#               Zero cost, zero network, always available.
VERIRAG_LLM_PROVIDER=auto

GROQ_API_KEY=
# Groq rotates its catalogue; list what your key can use with:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- retrieval -------------------------------------------------------------
# hashing | sentence-transformers   (see requirements-ml.txt for the latter)
VERIRAG_EMBEDDER=hashing
VERIRAG_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
VERIRAG_EMBED_DIM=384

# lexical | cross-encoder
VERIRAG_RERANKER=lexical
VERIRAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# numpy | chroma
VERIRAG_VECTOR_BACKEND=numpy

VERIRAG_TOP_K_DENSE=20
VERIRAG_TOP_K_LEXICAL=20
VERIRAG_TOP_K_FINAL=5
VERIRAG_CHUNK_TARGET_WORDS=140
VERIRAG_CHUNK_OVERLAP_LINES=2

# --- grounding / hallucination guard ---------------------------------------
# Sentences scoring below this against the cited evidence are flagged
# as unsupported by the verification pass.
VERIRAG_GROUNDING_THRESHOLD=0.42

# Hard refusal gate on the reranker's top score. Deliberately low: measured on
# the sample corpus (`python cli.py eval`), in-corpus and out-of-corpus score
# ranges overlap with the keyword embedder, and falsely refusing a real question
# is the worse failure. Raise it if you prefer more eager refusals.
VERIRAG_MIN_RETRIEVAL_SCORE=0.10

# Answers whose best evidence scores below this are returned but flagged
# "weak evidence" and forced to low confidence.
VERIRAG_LOW_CONFIDENCE_SCORE=0.35

# --- storage ---------------------------------------------------------------
VERIRAG_DATA_DIR=data
VERIRAG_TEMPERATURE=0.1
VERIRAG_MAX_TOKENS=900
